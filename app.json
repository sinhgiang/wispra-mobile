{
  "expo": {
    "name": "Wispra",
    "slug": "wispra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/wispra-icon.png",
    "scheme": [
      "wispramobile",
      "wispra"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.sinhgiang.wispramobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sinhgiang.wispramobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f1117",
        "foregroundImage": "./assets/brand/wispra-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/wispra-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1117",
          "image": "./assets/brand/wispra-mark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Wispra records your voice to turn it into text.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dd82f99-15b5-4b7d-b05e-5cb109f05b93"
      },
      "wispraCloud": {
        "apiBase": "https://wispra-web.vercel.app",
        "supabaseUrl": "https://tpiycamfsagesjeciubg.supabase.co",
        "supabasePublishableKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRwaXljYW1mc2FnZXNqZWNpdWJnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0OTA1MTAsImV4cCI6MjA5NzA2NjUxMH0.qxMVAbBSsBhWOeB5Xak_eQthjcI-wXGo87P7bVcoStU"
      }
    },
    "owner": "sinhgiang",
    "backgroundColor": "#0f1117"
  }
}
